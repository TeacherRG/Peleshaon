<?xml version="1.0" encoding="utf-8"?>
<!-- Прямоугольный виджет: картинка-карточка (оформление, дата, восход, галахический час, закат) и время поверх -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="6dp">

    <FrameLayout
        android:id="@+id/w_card_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center">

        <ImageView
            android:id="@+id/w_card"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/widget_card_name"
            android:scaleType="fitCenter" />

        <TextClock
            android:id="@+id/w_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"
            android:format12Hour="HH:mm"
            android:format24Hour="HH:mm"
            android:fontFeatureSettings="tnum"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="5"
            android:textColor="#F0CF86"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/w_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="12dp"
            android:maxLines="1"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
