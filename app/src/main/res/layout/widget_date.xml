<?xml version="1.0" encoding="utf-8"?>
<!-- Маленький виджет: еврейская дата — день числом крупно, рядом месяц и день недели; фон прозрачный. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="4dp">

    <TextView
        android:id="@+id/w_day"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:shadowColor="#99000000"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="7"
        android:textColor="#E2BF72"
        android:textSize="46sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/w_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="кислева"
            android:textColor="#F4F1E8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_weekday"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="вторник"
            android:textColor="#C9CFE3"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
